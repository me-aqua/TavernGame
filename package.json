{
  "name": "tavern-game",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "一个用 agent 循环驱动的文字游戏（纯前端，浏览器里直接玩）",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "npm run build && node e2e/smoke.mjs",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && node e2e/smoke.mjs",
    "hooks": "git config --local core.hooksPath .githooks",
    "prepare": "npm run hooks"
  },
  "keywords": [
    "agent",
    "text-game",
    "trpg",
    "llm",
    "vue"
  ],
  "license": "MIT",
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.1.1"
  }
}
