#!/usr/bin/env node
// Enforced at commit time. Violations fail the commit — discipline is not a
// request written in a doc, it is a check that runs.
// Escape hatch: SKIP_DISCIPLINE=1 git commit ... (explain the reason in the message)
import { execSync } from 'node:child_process'
import { readFileSync } from 'node:fs'

const git = (cmd) => execSync('git ' + cmd, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim()

// 跳过检查时也要提醒视觉检验 —— 它不是检查，是「别忘了看图」
if (process.env.SKIP_DISCIPLINE === '1') {
  console.log('⚠ SKIP_DISCIPLINE=1 —— 纪律检查已跳过')
  remindVisualCheck(git('diff --cached --name-only --diff-filter=ACM').split('\n').filter(Boolean))
  process.exit(0)
}

/**
 * Read the output of a failed execSync as text.
 *
 * ⚠️ Lesson learned: err.stdout / err.stderr are **Buffers**, and an **empty
 * Buffer is truthy**, so `String(err.stdout || err.stderr)` can pick an empty
 * Buffer and swallow the real message (a secret-scan failure once showed up as
 * an empty entry). Decode first, then pick by length.
 */
const readOutput = (err) => {
  const decode = (v) => (Buffer.isBuffer(v) ? v.toString('utf8') : String(v ?? ''))
  return (decode(err.stdout) || decode(err.stderr) || decode(err.message)).trim()
}

/**
 * 视觉提醒（**不阻塞**，只是提醒）。
 *
 * 为什么要有它：单元测试与结构探针都只能证明「没坏」，证明不了「看着对」——
 * 遮挡、拥挤、比例失衡这些只有看图才发现。改界面就必须真的看一眼截图。
 * 用户 2026-09-14 明确要求：每次提交都提醒 agent 做这一步。
 */
const UI_TOUCHED = /^(src\/App\.vue|src\/components\/|src\/styles\/|src\/locales\/)/
function remindVisualCheck(files) {
  const uiFiles = files.filter((f) => UI_TOUCHED.test(f))
  if (!uiFiles.length) {
    console.log('👀 视觉检验：这次没动界面文件；若你其实改过 UI，记得 npm run visual')
    return
  }
  console.log('')
  console.log('👀 视觉检验（这次动了界面，别只看检查通过）：')
  console.log('   npm run visual     # 10 状态 × 5 屏：渲染 + 遮挡/溢出/点按目标检查')
  console.log('   npm run stories    # 组件故事 × 浅深 × 中英')
  console.log('   然后**真的看图**：artifacts/screenshots/index.html 与 artifacts/stories/index.html')
  console.log('   检查通过 ≠ 好看：结构判据只保证没溢出、没被压住、点得到。')
  console.log('   有意改外观时：npx playwright test e2e/visual.spec.ts --update-snapshots')
  console.log(
    `   （界面文件 ${uiFiles.length} 个：${uiFiles.slice(0, 3).join(', ')}${uiFiles.length > 3 ? ' …' : ''}）`,
  )
  console.log('')
}

const problems = []
const allStaged = git('diff --cached --name-only --diff-filter=ACM').split('\n').filter(Boolean)
// Dev tooling (hooks, e2e, tests) never ships, so it is exempt from the
// source-discipline checks: they are tool code, and applying the same
// line-count / defensiveness rules to them only creates noise
const staged = allStaged.filter((f) => !/^(\.githooks|e2e|tests|scripts)\//.test(f))

// Text files only (skip images and other binaries)
const textFiles = staged.filter((f) => /\.(ts|vue|js|mjs|css|html|json|md|bat|yml|yaml)$/.test(f))
const contentOf = (file) => {
  try {
    return readFileSync(file, 'utf8')
  } catch {
    return ''
  }
}

// ---------- check 1: secret scan (the most important one) ----------
// Client-side project: API keys live with the player, so a real key can easily
// end up in the repo; once committed it stays in history.
try {
  execSync('node .githooks/checks/secrets.mjs ' + staged.map((f) => '"' + f + '"').join(' '), {
    stdio: 'pipe',
  })
} catch (err) {
  problems.push(readOutput(err))
}

// ---------- check 2: debug leftovers ----------
for (const file of textFiles) {
  const lines = contentOf(file).split('\n')
  lines.forEach((line, i) => {
    const at = `${file}:${i + 1}`
    if (/(^|[^\w.])debugger\b/.test(line)) problems.push(`[调试残留] ${at} —— debugger`)
    if (/\.only\(/.test(line)) problems.push(`[调试残留] ${at} —— .only 会跳过其余测试`)
    if (/\b(TODO|FIXME|XXX)\b/.test(line)) {
      problems.push(`[调试残留] ${at} —— ${line.trim().slice(0, 50)}`)
    }
  })
}

// ---------- check 3: swallowed errors ----------
// Rule: never swallow an error (no bare catch / no silent default).
// A catch body that neither throws/returns nor carries a comment is swallowing.
for (const file of textFiles.filter((f) => /\.(ts|vue|js|mjs)$/.test(f))) {
  const lines = contentOf(file).split('\n')
  lines.forEach((line, i) => {
    // Needs brace matching to isolate the catch body — otherwise a return
    // *after* the catch gets mistaken for an exit (verified: it did).
    const catchAt = line.indexOf('catch')
    if (catchAt < 0) return
    const fromCatch = lines.slice(i).join('\n').slice(catchAt)
    const body = (() => {
      let depth = 0
      let started = false
      for (let k = 0; k < fromCatch.length; k += 1) {
        const c = fromCatch[k]
        if (c === '{') {
          depth += 1
          started = true
          continue
        }
        if (c !== '}') continue
        depth -= 1
        if (started && depth === 0) return fromCatch.slice(0, k + 1)
      }
      return fromCatch
    })()
    if (!/throw|return/.test(body) && !/\/\/|\/\*/.test(body)) {
      problems.push(`[吞错误] ${file}:${i + 1} —— catch 块里既没抛出也没说明，错误被吞掉`)
    }
  })
}

// ---------- check 4: one-off abstractions ----------
const ABSTRACTION_NAMES = /\b(safeGet|safeSet|withFallback|tryOr|maybeNull|ensureDefined|nullSafe)\b/
for (const file of staged.filter((f) => /composables\/|utils?\/|helpers?\//.test(f))) {
  const m = contentOf(file).match(ABSTRACTION_NAMES)
  if (m) problems.push(`[多余抽象] ${file} —— ${m[0]}()，请确认它真有两个以上调用点`)
}

// ---------- check 5: defensive validation outside boundaries ----------
// Rule: validate only at system boundaries (user input, external API, network).
// ⚠️ 豁免范围跟着目录结构走：改目录时必须同步这里，否则规则会**悄悄失效**
//    （src/core 消失后，这条曾对外层代码全部放行过一阵）。
const BOUNDARY = /^src\/(game\/save|utils\/storage|utils\/calendar|agent\/llm|agent\/config)\.ts$/
for (const file of textFiles.filter((f) => /\.(ts|vue)$/.test(f) && !BOUNDARY.test(f))) {
  const lines = contentOf(file).split('\n')
  lines.forEach((line, i) => {
    if (/typeof\s+\w+\s*===\s*'(string|object|number)'/.test(line) && !/unknown/.test(line)) {
      problems.push(
        `[防御性校验] ${file}:${i + 1} —— 内部代码在做 typeof 校验；边界校验只属于系统边界（存档校验、存储适配、模型接口）`,
      )
    }
  })
}

// ---------- check 6: new source modules must ship with tests ----------
// Rule: every new feature must come with tests.
// Criterion: every src module must be mentioned somewhere under tests/.
const SRC = /^src\/(?!types\/|main\.ts$).*\.(ts|vue)$/
const testsContent = (() => {
  try {
    return execSync('git ls-files tests', { encoding: 'utf8' })
      .trim()
      .split('\n')
      .map((f) => (f.endsWith('.md') ? '' : readFileSync(f, 'utf8')))
      .join('\n')
  } catch {
    return ''
  }
})()

for (const file of textFiles.filter((f) => SRC.test(f))) {
  const moduleName = file
    .replace(/^src\//, '')
    .replace(/\.(ts|vue)$/, '')
    .split('/')
    .pop()
  if (!testsContent.includes(moduleName)) {
    problems.push(`[缺测试] ${file} —— tests/ 里没有任何地方提到「${moduleName}」；新增功能必须配测试`)
  }
}

// ---------- check 7: size (keep it minimal) ----------
// Threshold calibration (2026-09-14): Prettier splits template attributes, so
// the same semantics take more lines (SettingsDrawer.vue 201 → 278).
// That is the formatter's style, not bloated code, so the limit follows the new baseline.
const SIZE = { file: 400, func: 150, net: 500 }
const countLines = (s) => s.split('\n').length
// Generated files are not "code I wrote": lockfiles
const generated = /(^|\/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock)$/
// Docs are not bound by code line limits: DESIGN.md is a design derivation, long by nature
const notDocs = (f) => !/^doc\//.test(f) && !/^(README|AGENTS)\.md$/.test(f)
for (const file of textFiles.filter((f) => !generated.test(f) && notDocs(f))) {
  const n = countLines(contentOf(file))
  if (n > SIZE.file) problems.push(`[体积] ${file} —— ${n} 行（上限 ${SIZE.file}）`)
}
// Function length: count brace depth — crude but good enough
for (const file of textFiles.filter((f) => /\.(ts|vue)$/.test(f))) {
  const lines = contentOf(file).split('\n')
  lines.forEach((line, i) => {
    if (!/^\s*(export\s+)?(async\s+)?function\s|^\s*const\s+\w+\s*=\s*(async\s*)?\(/.test(line)) return
    let depth = 0
    let end = -1
    for (let j = i; j < lines.length; j++) {
      depth += (lines[j].match(/{/g) ?? []).length - (lines[j].match(/}/g) ?? []).length
      if (depth > 0) end = j
      if (end >= 0 && depth === 0) break
    }
    const len = end - i + 1
    if (len > SIZE.func) problems.push(`[体积] ${file}:${i + 1} —— 函数 ${len} 行（上限 ${SIZE.func}）`)
  })
}
// Net additions exclude generated files
const stat = git('diff --cached --shortstat -- . ":(exclude)package-lock.json"')
const net = Number(stat.match(/(\d+) insertion/)?.[1] ?? 0)
if (net > SIZE.net) {
  problems.push(`[体积] 本次改动 +${net} 行（上限 ${SIZE.net}）—— 拆成多次提交，或解释为什么必须一次改这么多`)
}

// ---------- check 8: line endings / BOM / encoding (three platforms at once) ----------
// Rules: index is always LF; .bat/.cmd must be CRLF in the working tree; no BOM.
// Source of truth is .gitattributes, read via `git ls-files --eol` — git's own
// verdict, never counted by hand (git add normalizes, which hides violations).
for (const file of allStaged) {
  const attr = git('check-attr eol text -- "' + file + '"')
  const eol = attr.match(/eol: (\S+)/)?.[1] ?? 'unspecified'
  if (!/text: (set|auto)/.test(attr)) continue // binary, leave it alone

  const report = git('ls-files --eol -- "' + file + '"')
  const indexSide = report.match(/i\/(\S+)/)?.[1]
  const worktreeSide = report.match(/w\/(\S+)/)?.[1]
  if (!indexSide || !worktreeSide) continue

  if (indexSide === 'crlf' || indexSide === 'mixed') {
    problems.push(`[换行] ${file} —— 索引里是 ${indexSide}；git 要求索引一律 lf`)
  }
  const wanted = eol === 'crlf' ? 'crlf' : 'lf'
  if (worktreeSide !== wanted) {
    problems.push(
      `[换行] ${file} —— 工作区是 ${worktreeSide}，应为 ${wanted}` +
        (wanted === 'crlf' ? '（Windows 脚本用 LF 会执行出错）' : '（Windows 编辑器默认写 CRLF，请改成 LF）'),
    )
  }

  const worktreeText = contentOf(file)
  if (worktreeText.charCodeAt(0) === 0xfeff) {
    problems.push(`[BOM] ${file} —— 带 UTF-8 BOM；脚本类文件会因为多出三个字节而报错`)
  }
  if (worktreeText.includes('\uFFFD')) {
    problems.push(`[编码] ${file} —— 不是合法 UTF-8（保存时请确认编码为 UTF-8，不要用 GBK）`)
  }
}

// ---------- check 9: syntax (TypeScript compiler API, sub-second) ----------
const syntaxTargets = staged.filter((f) => /\.(ts|vue)$/.test(f))
if (syntaxTargets.length) {
  try {
    execSync('node .githooks/checks/syntax.mjs ' + syntaxTargets.map((f) => '"' + f + '"').join(' '), {
      stdio: 'pipe',
    })
  } catch (err) {
    problems.push('[语法] ' + readOutput(err).split('\n').slice(-4).join(' / '))
  }
}

// ---------- check 10: code is ASCII (Chinese only in locales/docs) ----------
// Rule: outside src/locales/*.json and doc/, everything is ASCII — identifiers,
// object keys and string literals included. UI text goes through t('key').
// Comments are exempt (the scanner strips them before looking).
// ⚠️ Uses allStaged, not staged: tests/ and e2e/ are tool code exempt from the
// "source hygiene" checks, but ASCII is not hygiene — a Chinese assertion in a
// test is the same fixture-drift hazard as one in src/.
const asciiTargets = allStaged.filter((f) => /\.(ts|vue|css|html|mjs|js)$/.test(f))
if (asciiTargets.length) {
  try {
    execSync('node .githooks/checks/ascii.mjs ' + asciiTargets.map((f) => '"' + f + '"').join(' '), {
      stdio: 'pipe',
    })
  } catch (err) {
    problems.push(readOutput(err))
  }
}

// ---------- check 11: identifiers are English ----------
// Rule (user decision, 2026-09-14): every identifier is English, no domain
// exceptions. Works on the code skeleton, so a Chinese string cannot hide one.
const identifierTargets = allStaged.filter((f) => /\.(ts|vue|mjs|js)$/.test(f))
if (identifierTargets.length) {
  try {
    execSync(
      'node .githooks/checks/identifiers.mjs ' + identifierTargets.map((f) => '"' + f + '"').join(' '),
      { stdio: 'pipe' },
    )
  } catch (err) {
    problems.push(readOutput(err))
  }
}

// ---------- check 12: prompts must not be inlined ----------
const promptTargets = staged.filter((f) => /^src\/.*\.(ts|vue)$/.test(f))
if (promptTargets.length) {
  try {
    execSync('node .githooks/checks/prompts.mjs ' + promptTargets.map((f) => '"' + f + '"').join(' '), {
      stdio: 'pipe',
    })
  } catch (err) {
    problems.push(readOutput(err))
  }
}

// ---------- check 13: ESLint (typed rules catch real bugs like floating promises) ----------
const lintTargets = staged.filter((f) => /\.(ts|vue|js|mjs)$/.test(f))
let lintPromise = null
if (lintTargets.length) {
  lintPromise = new Promise((resolve) => {
    try {
      execSync('npx eslint ' + lintTargets.map((f) => '"' + f + '"').join(' '), { stdio: 'pipe' })
      resolve(null)
    } catch (err) {
      resolve(readOutput(err).split('\n').slice(0, 12).join('\n'))
    }
  })
}

// ---------- check 14: typecheck + unit tests (in parallel, to cut wait time) ----------
const needsHeavy = staged.some((f) => /\.(ts|vue)$/.test(f)) || /package\.json|tsconfig/.test(staged.join(' '))
const heavyTasks = []
if (needsHeavy) {
  heavyTasks.push(
    new Promise((resolve) => {
      try {
        execSync('npm run -s typecheck', { stdio: 'pipe' })
        resolve(null)
      } catch (err) {
        resolve('typecheck：\n' + readOutput(err).split('\n').slice(0, 10).join('\n'))
      }
    }),
  )
  // Unit tests are fast (<1s) — catching breakage here is better than at push time
  heavyTasks.push(
    new Promise((resolve) => {
      try {
        execSync('npm run -s test', { stdio: 'pipe' })
        resolve(null)
      } catch (err) {
        resolve('测试：\n' + readOutput(err).split('\n').slice(-12).join('\n'))
      }
    }),
  )
}

if (lintPromise || heavyTasks.length) {
  const results = await Promise.all([lintPromise, ...heavyTasks])
  for (const result of results) {
    if (!result) continue
    if (result.startsWith('typecheck') || result.startsWith('测试')) {
      problems.push('[' + result.split('：')[0] + '] ' + result.split('\n').slice(1).join('\n     '))
    } else {
      problems.push('[lint]\n' + result.split('\n').map((l) => '     ' + l).join('\n'))
    }
  }
}

// ⚠️ If anything is already wrong, report and stop BEFORE the formatter below:
// Prettier exits with "re-commit" which would otherwise mask the real reason
// (a secret-scan failure once got hidden behind "Prettier 已格式化" — verified).
if (problems.length) {
  console.error('\n✖ 纪律检查未通过：\n')
  for (const p of problems) console.error('  ' + p)
  console.error(`\n共 ${problems.length} 项。逐条修掉，或用 SKIP_DISCIPLINE=1 跳过（需说明理由）。\n`)
  process.exit(1)
}

// ---------- check 15: formatting (Prettier fixes in place and re-stages) ----------
const formatTargets = staged.filter((f) => /\.(ts|vue|js|mjs|json|css|html|md|yml|yaml)$/.test(f))
if (formatTargets.length && !process.env.SKIP_FORMAT) {
  try {
    const out = execSync('npx prettier --write ' + formatTargets.map((f) => '"' + f + '"').join(' '), {
      stdio: 'pipe',
      encoding: 'utf8',
    })
    if (/ms$|ms\b/m.test(out) && !/unchanged/.test(out)) {
      // Re-stage the fixed content, otherwise the unformatted version is committed
      execSync('git add ' + formatTargets.map((f) => '"' + f + '"').join(' '), { stdio: 'pipe' })
      console.log('⟳ Prettier 已格式化并重新暂存；请再执行一次 git commit')
      process.exit(1)
    }
  } catch (err) {
    problems.push('[格式化] Prettier 失败：' + readOutput(err).slice(0, 200))
  }
}

if (problems.length) {
  console.error('\n✖ 格式化后仍有问题：\n')
  for (const p of problems) console.error('  ' + p)
  console.error('')
  process.exit(1)
}
console.log(`✓ 纪律检查通过（${staged.length} 个文件）`)
remindVisualCheck(allStaged)
