#!/usr/bin/env node
// Pre-push checks: the heavy jobs that do not fit in a sub-second pre-commit.
//
// Why layered:
//   pre-commit runs on every commit  → syntax / format / lint / types / unit tests
//   pre-push   runs on every push    → coverage gate / build / end-to-end
// This keeps "never push something broken" without making every commit wait.
import { execSync } from 'node:child_process'

if (process.env.SKIP_DISCIPLINE === '1') {
  console.log('⚠ SKIP_DISCIPLINE=1 —— 推送前检查已跳过')
  process.exit(0)
}

const tasks = [
  { name: '覆盖率门禁', command: 'npm run -s test:coverage' },
  { name: '构建', command: 'npm run -s build' },
  { name: '端到端（真浏览器，Playwright）', command: 'npx playwright test e2e/smoke.spec.ts' },
  { name: '组件故事（Storybook + Playwright）', command: 'npm run stories' },
]

const failures = []
for (const task of tasks) {
  process.stdout.write(`⟳ ${task.name} … `)
  try {
    execSync(task.command, { stdio: 'pipe' })
    console.log('✓')
  } catch (err) {
    console.log('✖')
    failures.push({ ...task, output: String(err.stdout || err.message) })
  }
}

if (failures.length) {
  console.error('\n✖ 推送前检查未通过：\n')
  for (const failure of failures) {
    console.error(`【${failure.name}】`)
    console.error(
      failure.output
        .split('\n')
        .slice(-15)
        .map((l) => '  ' + l)
        .join('\n'),
    )
    console.error('')
  }
  console.error('修好后重试，或用 SKIP_DISCIPLINE=1 git push 跳过（需说明理由）。\n')
  process.exit(1)
}
console.log('✓ 推送前检查全部通过')
